# Signs the workspace and portal session cookies. Any long random string.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string

# The shared password internal staff type at /unlock.
# Used to seed the workspace password on first boot; change it later in Settings.
WORKSPACE_PASSWORD=agency

# Leave unset for local development: the app then runs file-based PGlite in .data/pg.
# Set it to a Postgres connection string (Supabase, Neon, RDS) to use hosted Postgres.
# Required for any deployment - a serverless filesystem cannot host PGlite.
# DATABASE_URL=postgresql://user:password@host:5432/postgres
